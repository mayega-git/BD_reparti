# ─── Configuration Tailscale du cluster vpdf ───
# Copier vers .env, adapter IP_LOCALE et (sur les auxiliaires) IP_MAITRE.
#
# Pré-requis sur chaque machine :
#   curl -fsSL https://tailscale.com/install.sh | sh
#   sudo tailscale up --authkey="${TAILSCALE_AUTHKEY}"
#   tailscale ip -4                # → IP à mettre dans IP_LOCALE

CLUSTER_NAME=vpdf-cluster

# ─── IP Tailscale de CETTE machine ─────────────────────────────────────
# Récupérée via `tailscale ip -4`. Format : 100.x.x.x
IP_LOCALE=

# ─── IP Tailscale de la machine MAÎTRE ─────────────────────────────────
# Sur la machine maître : laisser vide.
# Sur chaque auxiliaire  : 100.117.105.35  (IP Tailscale de la principale)
IP_MAITRE=

# ─── Non utilisé en mode Tailscale ─────────────────────────────────────
# (le filtrage par sous-réseau ne sert qu'en LAN classique)
SOUS_RESEAU=100.64.0.0/10

# ─── Clé d'auth Tailscale (optionnelle, pour scripter `tailscale up`) ───
TAILSCALE_AUTHKEY=
