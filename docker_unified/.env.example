# ─── Configuration du cluster vpdf ───
# Copier ce fichier vers .env et adapter.

# Nom du cluster Elasticsearch (identique sur toutes les machines).
CLUSTER_NAME=vpdf-cluster

# IP locale de CETTE machine (annoncée aux autres nœuds du cluster).
#   - RENSEIGNÉE → utilisée directement (ex : 192.168.123.155)
#   - VIDE       → auto-détection via SOUS_RESEAU ci-dessous
IP_LOCALE=

# Sous-réseau CIDR du LAN — utilisé UNIQUEMENT si IP_LOCALE est vide,
# pour filtrer les interfaces et éviter Docker/VPN.
SOUS_RESEAU=192.168.123.0/24

# IP du nœud maître.
#   - VIDE     → cette machine EST le maître (lancer --profile master)
#   - RENSEIGNÉ → cette machine est un auxiliaire (lancer --profile aux)
IP_MAITRE=

# ─── Tailscale (optionnel) ───
# Clé d'authentification Tailscale pour joindre votre tailnet.
# Forme : tskey-auth-xxxxxxxxxx
# Avant `docker compose up`, lancer :
#   sudo tailscale up --authkey=${TAILSCALE_AUTHKEY}
#   tailscale ip -4        # récupérer l'IP attribuée → à mettre dans IP_LOCALE
TAILSCALE_AUTHKEY=
